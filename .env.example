# Copy this file to `.env` (which is gitignored) and fill in the keys you have:
#
#   cp .env.example .env
#   # then edit .env
#
# `npm run serve` and `npm run smoke:live` load .env automatically (via
# --env-file-if-exists). You can also export these in your shell instead.
# Never commit real keys. `.env` is gitignored; this `.env.example` must stay empty.

# ── Live cue generation (the phone app's /api/cue) ────────────────────────────
# With a key set, every cue is generated fresh per session (grounded in the Cue
# Bank, human-filtered). Without it, the app runs in an OFFLINE demo mode that
# rotates real lines from the Cue Bank.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5      # optional; low-latency tier is the default

# ── Natural voice (the phone app's /api/tts) ──────────────────────────────────
# Set ONE provider's key for a real, neutral, grounded voice. With neither set,
# the server streams a soft tone stand-in so the pipeline still runs end-to-end.
OPENAI_API_KEY=
# GOOGLE_TTS_API_KEY=
# TTS_PROVIDER=openai                   # openai | google | tone (default: infer from keys)
# TTS_VOICE=onyx                        # one neutral voice (OpenAI: onyx; Google: en-US-Neural2-D)
# TTS_MODEL=gpt-4o-mini-tts             # OpenAI TTS model
# TTS_INSTRUCTIONS=Speak calmly and grounded. Unhurried, neutral. Not theatrical.

# ── The Session Arc (real timing) — tune without touching code ────────────────
# Defaults come from the Session Arc design (30-min example, wall at 62%). Set the
# real class length here; every cue placement scales with it.
# SESSION_LENGTH_MIN=30                  # or SESSION_LENGTH_MS=1800000
# WALL_AT=0.62                           # where the wedge (felt event) lands, 0..1
# MIN_GAP_MS=12000                       # minimum silence between cues
# ARC_JSON={"stages":[...]}              # full/partial SessionArc override as JSON

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0                           # bind on 0.0.0.0 so a phone on your LAN can reach it
