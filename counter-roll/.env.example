# Copy to .env.local and fill in. .env.local is gitignored.

# Database. Local development uses a SQLite file (created on first run).
# On Vercel, use a Turso database: libsql://<name>-<org>.turso.io plus its token.
DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=

# Single-owner auth. The passcode the owner types on /login.
OWNER_PASSCODE=

# Secret used to sign the session cookie. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
